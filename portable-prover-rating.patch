+                        {
+                            "prover": name,
+                            "task": task_id,
+                            "seed": 0,
+                            "status": "verified" if success else "timeout",
+                            "elapsed_seconds": 1.0 if success else 10.0,
+                            "checker_accepted": success,
+                            "artifact_sha256": "simulated-not-a-proof"
